# Домен, который смотрит на IP вашего VPS (A-запись). Нужен для HTTPS.
DOMAIN=list.example.ru
# Тот же адрес с https://
WEBAPP_URL=https://list.example.ru
# Токен и имя бота от @BotFather
BOT_TOKEN=
BOT_USERNAME=
# Любая случайная строка, например из `openssl rand -hex 32`
WEBHOOK_SECRET=
# Если сборка падает на `npm ci`: registry.npmjs.org работает через Cloudflare,
# который в России замедляют. Тогда укажите зеркало npm, например:
# NPM_REGISTRY=https://registry.npmmirror.com/
