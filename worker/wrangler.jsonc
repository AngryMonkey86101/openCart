{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opencart",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Собранный Mini App (web/dist) раздаётся этим же воркером.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/bot/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "opencart",
      // Заменить на id из `wrangler d1 create opencart`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Публичный адрес воркера, например https://opencart.<account>.workers.dev
    "WEBAPP_URL": "",
    // Имя бота без @, нужно для ссылок-приглашений.
    "BOT_USERNAME": ""
  }
  // Секреты: `wrangler secret put BOT_TOKEN` и `wrangler secret put WEBHOOK_SECRET`.
}
